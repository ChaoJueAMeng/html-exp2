{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "html-exp2",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
